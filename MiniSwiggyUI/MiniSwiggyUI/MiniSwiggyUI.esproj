    <None Remove="src\app\shared\guards\**" />
    <None Remove="src\app\shared\interceptors\**" />
    <None Remove="src\app\shared\interfaces\**" />
    <None Remove="src\app\shared\models\**" />
    <None Remove="src\app\shared\pipes\**" />
    <None Remove="src\app\shared\services\**" />
    <None Remove="src\app\shared\validators\**" />
    <TypeScriptConfiguration Remove="src\app\core\constants\**" />
    <TypeScriptConfiguration Remove="src\app\core\guards\**" />
    <TypeScriptConfiguration Remove="src\app\core\helpers\**" />
    <TypeScriptConfiguration Remove="src\app\features\auth\forgot-password\**" />
    <TypeScriptConfiguration Remove="src\app\features\category\**" />
    <TypeScriptConfiguration Remove="src\app\features\error\**" />
    <TypeScriptConfiguration Remove="src\app\features\home\**" />
    <TypeScriptConfiguration Remove="src\app\features\payment\**" />
    <TypeScriptConfiguration Remove="src\app\features\reviews\**" />
